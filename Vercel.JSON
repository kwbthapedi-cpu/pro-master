{
  "version": 2,
  "name": "pro-master",
  "routes": [
    { "src": "/auth(.*)",         "dest": "/auth/index.html" },
    { "src": "/onboarding(.*)",   "dest": "/onboarding/index.html" },
    { "src": "/dashboard(.*)",    "dest": "/dashboard/index.html" },
    { "src": "/studio(.*)",       "dest": "/studio/index.html" },
    { "src": "/platform(.*)",     "dest": "/platform/index.html" },
    { "src": "/distribution(.*)", "dest": "/distribution/index.html" },
    { "src": "/admin(.*)",        "dest": "/admin/index.html" },
    { "src": "/bcl(.*)",          "dest": "/bcl/index.html" },
    { "src": "/",                 "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "microphone=*, camera=()" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "unsafe-none" }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}
